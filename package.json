{
  "name": "besttrips",
  "version": "1.0.0",
  "description": "Travel guides and destination recommendations",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "pages:build": "npx @cloudflare/next-on-pages",
    "preview": "npm run pages:build && wrangler pages dev .vercel/output/static",
    "deploy": "npm run pages:build && wrangler pages deploy .vercel/output/static --project-name=besttrips"
  },
  "keywords": [
    "travel",
    "guides",
    "hotels",
    "destinations"
  ],
  "author": "BestTrips.org",
  "license": "ISC",
  "dependencies": {
    "googleapis": "^171.4.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "wrangler": "^3.114.17"
  }
}
